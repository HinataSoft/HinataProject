{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft": "Information",
            "Microsoft.AspNetCore": "Information",
            "Microsoft.EntityFrameworkCore.Database.Command": "None",
            "Microsoft.EntityFrameworkCore": "Warning",
            "Microsoft.AspNetCore.Authentication": "Debug",
            "Microsoft.IdentityModel": "Debug"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "DbContext": "Server=localhost;Port=5432;Database=HinataProject;User ID=postgres;Password=password;"
    },
    "ConnectionStringsLogSettings": {
        "DbContext": {
            "EnableLog": false,
            "EnableSensitiveDataLogging": false
        }
    },
    "Authentication": {
        "Authority": "http://localhost:5999",
        "Audience": "HinataAPI",
        "RequireHttpsMetadata": false,
        "ValidateIssuer": true,
        "ValidateAudience": true,
        "ValidateLifetime": true,
        "ValidateIssuerSigningKey": false,
        "RoleClaimType": "roles",
        "NameClaimType": "name"
    },
    "Frontend": {
        "OAuth": {
            "AuthorizationEndpoint": "http://localhost:5999/connect/authorize",
            "TokenEndpoint": "http://localhost:5999/connect/token",
            "ClientId": "auth-client",
            "ClientSecret": "auth-secret",
            "RedirectUri": "http://localhost:5130/callback",
            "Scope": "auth"
        }
    }
}
